# Copy this file to .env and fill in your own keys. NEVER commit a real .env.
# Frontend: copy the VITE_ lines into frontend/.env.local (Vite reads that file).

# --- Database ---
# Docker Compose default (Postgres + pgvector). For local dev without Docker,
# point this at any Postgres 16 + pgvector, or leave the SQLite default for tests.
DATABASE_URL=postgresql+psycopg://contract:contract@db:5432/contract_review

# --- Clerk (https://dashboard.clerk.com) ---
# Create a Clerk application, then copy from API Keys:
#   CLERK_PUBLISHABLE_KEY = pk_test_... / pk_live_...
#   CLERK_SECRET_KEY     = sk_test_... / sk_live_...
#   CLERK_JWKS_URL       = https://<your-clerk-frontend-api-domain>/.well-known/jwks.json
#   (find the frontend API domain on the same API Keys page, e.g.
#    https://clerk.your-app-123.clerk.accounts.dev/.well-known/jwks.json)
#   CLERK_ISSUER         = the same frontend API domain URL (iss claim on tokens)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=

# --- OpenRouter (https://openrouter.ai/keys) ---
# Create a key, no card needed for the free models used here.
# Chat models: nvidia/nemotron-3-ultra-550b-a55b:free (default) or google/gemma-4-31b-it:free
# Embeddings:  nvidia/nemotron-3.5-embed-1b:free (2048 dims)
# Free tier: 50 free-model requests/day per account. When it is exhausted
# the app falls back to Groq (below) instead of failing the review.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b:free

# --- Groq backup (https://console.groq.com/keys) ---
# Optional. Only used when OpenRouter is rate-limited. Groq has no
# embeddings API, so retrieval then falls back to keywords.
GROQ_API_KEY=
GROQ_CHAT_MODEL=qwen/qwen3.8-27b

# --- Frontend (frontend/.env.local) ---
VITE_CLERK_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:8000

# --- Review fallback (dev/eval only) ---
# REVIEW_FALLBACK=rule_based lets the eval script and tests run the review
# pipeline without an OpenRouter key, using a deterministic keyword extractor.
# NEVER set this in production: it is not an AI review.
REVIEW_FALLBACK=
